#!/usr/bin/env bash
# Server-side required PR checks own the main-branch gate (PRINCIPLES.md amendment 2.0.0).
# This hook owns the local harness audit; neither layer replaces the other.
set -euo pipefail

# Work happens in a linked worktree, never the primary checkout (AGENTS.md). The primary
# tree is what `npm run dev`, a render and a bench read; a branch parked there makes every
# measurement ambiguous after the fact, and nothing downstream can tell the difference.
# ALLOW_PRIMARY_WORKTREE=1 exists for the emergency, and leaves a trace in the shell
# history that `--no-verify` would not.
if [ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ] \
   && [ "${ALLOW_PRIMARY_WORKTREE:-0}" != "1" ]; then
  echo "pre-commit: this is the primary checkout, not a place to commit from." >&2
  echo "    python3 scripts/dev/worktree.py start <branch>" >&2
  exit 1
fi

exec scripts/audit/harness-audit.sh
