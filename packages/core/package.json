{
  "name": "subtractive-synthesizers.js",
  "version": "0.1.0",
  "description": "Analog-style subtractive synthesizers for the browser. Computed on the fly, no samples, tens of kilobytes.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./presets": { "types": "./dist/presets.d.ts", "default": "./dist/presets.js" },
    "./wasm": "./dist/wasm/subtractive_dsp.wasm"
  },
  "engines": { "node": ">=18" },
  "files": ["dist", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "scripts": { "build": "node scripts/build.mjs" },
  "keywords": [
    "synthesizer", "synth", "subtractive", "analog", "audio", "webaudio",
    "audioworklet", "wasm", "dsp", "filter", "oscillator", "music"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keunwoochoi/subtractive-synthesizers.js.git",
    "directory": "packages/core"
  },
  "homepage": "https://keunwoochoi.github.io/subtractive-synthesizers.js/apps/playground/showcase.html",
  "bugs": { "url": "https://github.com/keunwoochoi/subtractive-synthesizers.js/issues" }
}
